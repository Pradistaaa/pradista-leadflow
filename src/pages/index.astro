    }

    const campaignId =
      Number(
        deleteButton.dataset.campaignDelete
      );

    const campaign =
      campaigns.find(
        item =>
          Number(item.id) === campaignId
      );

    if (!campaign) {
      return;
    }

    const confirmed =
      confirm(
        `Hapus campaign "${campaign.name}"?`
      );

    if (!confirmed) {
      return;
    }

    /* =========================
       DELETE DARI SUPABASE
       ========================= */

    const { error } =
      await supabase
        .from("leadflow_campaigns")
        .delete()
        .eq(
          "id",
          campaign.cloudId || campaign.id
        );

    if (error) {

      console.error(
        "Gagal menghapus campaign:",
        error
      );

      alert(
        "Campaign gagal dihapus dari Supabase."
      );

      return;
    }

    /* =========================
       HAPUS DARI DATA CRM
       ========================= */

    campaigns =
      campaigns.filter(
        item =>
          Number(item.id) !== campaignId
      );

    /* =========================
       UPDATE CACHE LOKAL
       ========================= */

    localStorage.setItem(
      CAMPAIGN_STORAGE_KEY,
      JSON.stringify(campaigns)
    );

    updateCampaignStats();
    renderCampaigns();

    console.log(
      "Campaign berhasil dihapus dari Supabase:",
      campaign
    );

  }
);

