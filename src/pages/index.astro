function getSegmentStatusLabel(status) {
  const labels = {
    new: "New",
    contacted: "Sudah Dihubungi",
    follow: "Follow-up",
    meeting: "Meeting",
    deal: "Deal"
  };

  return labels[status] || status;
}


function getSegmentLeadCount(segment) {
  return leads.filter(lead => {
    const matchCity =
      !segment.city ||
      lead.city === segment.city;

    const matchCategory =
      !segment.category ||
      lead.category === segment.category;

    const matchStatus =
      !segment.status ||
      lead.status === segment.status;

    return (
      matchCity &&
      matchCategory &&
      matchStatus
    );
  }).length;
}


