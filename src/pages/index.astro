/* =====================================================
   PIC INLINE EDIT
   ===================================================== */

.pipeline-detail-pic-wrap {
  position: relative;
}

.pipeline-pic-display {
  margin-top: 6px;
  min-height: 38px;
  padding: 0 12px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  background: #171e1a;
  border: 1px solid #25332b;
  border-radius: 9px;

  color: #e7eee9;
  font-size: 12px;

  cursor: pointer;

  transition:
    border-color .2s ease,
    background .2s ease,
    box-shadow .2s ease;
}

.pipeline-pic-display:hover {
  border-color: rgba(25,216,116,.45);
  background: #1a241f;
}

.pipeline-pic-edit {
  color: #68756d;
  font-size: 13px;
  transition: color .2s ease;
}

.pipeline-pic-display:hover .pipeline-pic-edit {
  color: #19d874;
}

.pipeline-pic-input {
  display: none;

  width: 100%;
  box-sizing: border-box;

  margin-top: 6px;
  min-height: 38px;

  padding: 0 12px;

  background: #171e1a;
  border: 1px solid #19d874;
  border-radius: 9px;

  color: #f2f7f4;
  font-size: 12px;

  outline: none;

  box-shadow:
    0 0 0 3px rgba(25,216,116,.08);
}

.pipeline-pic-input::placeholder {
  color: #68756d;
}

.pipeline-pic-hint {
  display: none;

  margin-top: 5px;

  color: #68756d;
  font-size: 9px;
}

.pipeline-detail-pic-wrap.editing
.pipeline-pic-display {
  display: none;
}

.pipeline-detail-pic-wrap.editing
.pipeline-pic-input {
  display: block !important;
  pointer-events: auto;
  position: relative;
  z-index: 20;
}

.pipeline-detail-pic-wrap.editing
.pipeline-pic-hint {
  display: block;
}

/* =====================================================
   CAMPAIGN - FINAL ASTRO SAFE
   ===================================================== */

#page-campaign .page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 20px;
}

#page-campaign .page-header h1 {
  margin: 0;
  font-size: 22px;
}

#page-campaign .page-header p {
  margin: 6px 0 0;
  color: #68756d;
  font-size: 11px;
}


/* =====================================================
   STATISTICS
   ===================================================== */

#page-campaign .stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  margin-bottom: 18px;
}

#page-campaign .stat-card {
  background: #171e1a;
  border: 1px solid #25332b;
  border-radius: 12px;
  padding: 16px;
}

#page-campaign .stat-card span {
  display: block;
  color: #68756d;
  font-size: 10px;
  margin-bottom: 8px;
}

#page-campaign .stat-card strong {
  display: block;
  color: #f1f6f3;
  font-size: 22px;
}


/* =====================================================
   CONTENT CARD
   ===================================================== */

#page-campaign .content-card {
  background: #171e1a;
  border: 1px solid #25332b;
  border-radius: 12px;
  overflow: hidden;
}

#page-campaign .content-card-header {
  padding: 16px 18px;
  border-bottom: 1px solid #25332b;
}

#page-campaign .content-card-header h3 {
  margin: 0;
  font-size: 13px;
  color: #f1f6f3;
}

#page-campaign .content-card-header p {
  margin: 5px 0 0;
  color: #68756d;
  font-size: 10px;
}


/* =====================================================
   CAMPAIGN LIST
   ===================================================== */

#page-campaign #campaignList {
  display: flex;
  flex-direction: column;
  width: 100%;
}


/* =====================================================
   CAMPAIGN ITEM
   ===================================================== */

#page-campaign :global(.campaign-item) {
  display: block;
  width: 100%;
  padding: 18px;
  border-bottom: 1px solid #25332b;
  background: #171e1a;
  box-sizing: border-box;
  transition:
    background .2s ease,
    border-color .2s ease;
}

#page-campaign :global(.campaign-item:last-child) {
  border-bottom: 0;
}

#page-campaign :global(.campaign-item:hover) {
  background: #1a211d;
}


/* =====================================================
   CAMPAIGN TOP
   ===================================================== */

#page-campaign :global(.campaign-item-top) {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  width: 100%;
  gap: 15px;
}

#page-campaign :global(.campaign-item-title) {
  display: block;
  margin: 0 0 9px 0;
  color: #f1f6f3;
  font-size: 13px;
  font-weight: 700;
  line-height: 1.4;
}


/* =====================================================
   META
   ===================================================== */

#page-campaign :global(.campaign-meta) {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 7px;
}

#page-campaign :global(.campaign-meta span) {
  display: inline-flex;
  align-items: center;
  gap: 4px;

  padding: 5px 8px;

  border-radius: 7px;
  background: rgba(255,255,255,.04);
  border: 1px solid #25332b;

  color: #8d9a91;
  font-size: 9px;
  line-height: 1;
  white-space: nowrap;
}


/* =====================================================
   MESSAGE
   ===================================================== */

#page-campaign :global(.campaign-message-preview) {
  display: block;

  width: 100%;
  margin-top: 14px;
  padding: 12px;

  box-sizing: border-box;

  background: #121815;
  border: 1px solid #25332b;
  border-radius: 9px;

  color: #c5d0c9;
  font-size: 10px;
  line-height: 1.6;

  white-space: pre-wrap;
  overflow-wrap: anywhere;
  word-break: break-word;
}


/* =====================================================
   ACTION BUTTONS
   ===================================================== */

#page-campaign :global(.campaign-actions) {
  display: flex;
  align-items: center;
  gap: 7px;

  margin-top: 12px;
}

#page-campaign :global(.campaign-actions button) {
  appearance: none;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-height: 30px;

  padding: 6px 10px;

  background: #121815;
  border: 1px solid #25332b;
  border-radius: 7px;

  color: #c5d0c9;

  font-family: inherit;
  font-size: 9px;
  font-weight: 500;

  cursor: pointer;

  transition:
    background .2s ease,
    border-color .2s ease,
    color .2s ease,
    transform .2s ease;
}

#page-campaign :global(.campaign-actions button:hover) {
  background: rgba(25,216,116,.06);
  border-color: #19d874;
  color: #19d874;
  transform: translateY(-1px);
}


/* EDIT */

#page-campaign :global(.campaign-edit-btn:hover) {
  border-color: #19d874;
  color: #19d874;
}


/* DELETE */

#page-campaign :global(.campaign-delete-btn) {
  color: #ff8585;
}

#page-campaign :global(.campaign-delete-btn:hover) {
  background: rgba(255,92,92,.06);
  border-color: #ff5c5c;
  color: #ff5c5c;
}


/* =====================================================
   EMPTY CAMPAIGN
   ===================================================== */

#page-campaign #campaignList .empty-page {
  padding: 45px 20px;
}

#page-campaign #campaignList .empty-icon {
  margin-bottom: 12px;
}

#page-campaign #campaignList h2 {
  font-size: 14px;
}

#page-campaign #campaignList p {
  font-size: 10px;
}


/* =====================================================
   RESPONSIVE
   ===================================================== */

@media (max-width: 800px) {

  #page-campaign .stats-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

}


@media (max-width: 600px) {

  #page-campaign :global(.campaign-item) {
    padding: 14px;
  }

  #page-campaign :global(.campaign-meta) {
    gap: 5px;
  }

  #page-campaign :global(.campaign-actions) {
    flex-wrap: wrap;
  }

}


@media (max-width: 520px) {

  #page-campaign .page-header {
    flex-direction: column;
    align-items: flex-start;
  }

  #page-campaign .stats-grid {
    grid-template-columns: 1fr;
  }

}

/* =====================================================
   CAMPAIGN MODAL
   ===================================================== */

#campaignModal .modal-box {
  width: min(560px, calc(100vw - 32px));
  max-width: 560px;
}

#campaignModal .modal-header {
  padding-bottom: 14px;
  margin-bottom: 0;
}

#campaignModal .modal-header h2 {
  font-size: 15px;
}

#campaignFormArea {
  min-height: 80px;
  padding-top: 4px;
}

#campaignFormArea::before {
  content: "Form Campaign";
  display: block;
  color: #68756d;
  font-size: 10px;
  margin-bottom: 12px;
}

/* =====================================================
   CAMPAIGN MESSAGE UI
   ===================================================== */

#campaignFormArea .form-group {
  margin-bottom: 16px;
}

#campaignFormArea label {
  display: block;
  margin-bottom: 7px;

  color: #dce5df;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .2px;
}

#campaignFormArea input,
#campaignFormArea select,
#campaignFormArea textarea {
  width: 100%;
  box-sizing: border-box;

  background: #111713;
  border: 1px solid #29372f;
  border-radius: 9px;

  color: #edf4ef;
  font-family: inherit;
  font-size: 11px;

  outline: none;
  transition: .2s ease;
}

#campaignFormArea input,
#campaignFormArea select {
  height: 38px;
  padding: 0 11px;
}

#campaignFormArea textarea {
  min-height: 130px;
  padding: 11px;

  resize: vertical;
  line-height: 1.6;
}

#campaignFormArea input:focus,
#campaignFormArea select:focus,
#campaignFormArea textarea:focus {
  border-color: #19d874;
  box-shadow:
    0 0 0 3px rgba(25,216,116,.07);
}

#campaignFormArea input::placeholder,
#campaignFormArea textarea::placeholder {
  color: #536158;
}

#campaignFormArea select {
  cursor: pointer;
}

.campaign-message-hint {
  display: block;

  margin-top: 7px;

  color: #68756d;
  font-size: 9px;
  line-height: 1.5;
}

.campaign-message-hint strong {
  color: #19d874;
  font-weight: 600;
}

:global(.segment-view-btn),
:global(.segment-delete-btn) {
  border-radius: 8px;
  padding: 8px 10px;
  font-size: 10px;
  font-weight: 600;
  cursor: pointer;
  transition: .2s ease;
}

:global(.segment-view-btn) {
  border: 1px solid rgba(25,216,116,.25);
  background: rgba(25,216,116,.08);
  color: var(--green);
}

:global(.segment-view-btn:hover) {
  background: rgba(25,216,116,.16);
  border-color: rgba(25,216,116,.5);
  transform: translateY(-1px);
}

:global(.segment-delete-btn) {
  border: 1px solid rgba(255,92,92,.22);
  background: rgba(255,92,92,.06);
  color: #ff8b8b;
}

:global(.segment-delete-btn:hover) {
  background: rgba(255,92,92,.14);
  border-color: rgba(255,92,92,.48);
  transform: translateY(-1px);
}

/* =========================================================
   SETTINGS — PROFIL & AKUN
   CSS khusus halaman Settings
   Tidak mengubah halaman CRM lainnya
   ========================================================= */

#page-settings {
  max-width: 1100px;
}

/* Header Settings */
#page-settings .page-header {
  margin-bottom: 22px;
}

#page-settings .page-header h1 {
  margin: 0 0 6px;
  font-size: 28px;
  font-weight: 700;
}

#page-settings .page-header p {
  margin: 0;
  color: var(--muted);
  font-size: 14px;
}

/* Card */
#page-settings .settings-card {
  width: 100%;
  max-width: 850px;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 12px;
  overflow: hidden;
}

/* Card Header */
#page-settings .settings-card-header {
  padding: 20px 22px;
  border-bottom: 1px solid var(--border);
}

#page-settings .settings-card-header h2 {
  margin: 0 0 5px;
  font-size: 18px;
  font-weight: 650;
}

#page-settings .settings-card-header p {
  margin: 0;
  color: var(--muted);
  font-size: 13px;
}

/* Form */
#page-settings .settings-form {
  padding: 22px;
}

#page-settings .form-group {
  margin-bottom: 18px;
}

#page-settings .form-group:last-of-type {
  margin-bottom: 4px;
}

#page-settings .form-group label {
  display: block;
  margin-bottom: 7px;
  color: var(--muted);
  font-size: 12px;
  font-weight: 500;
}

#page-settings .form-group input {
  width: 100%;
  height: 42px;
  padding: 0 13px;
  box-sizing: border-box;

  background: var(--card2);
  border: 1px solid var(--border);
  border-radius: 8px;

  color: var(--text);
  font-size: 13px;
  outline: none;

  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

#page-settings .form-group input::placeholder {
  color: #66736b;
}

#page-settings .form-group input:focus {
  border-color: var(--green-dark);
  box-shadow: 0 0 0 2px rgba(25, 216, 116, 0.08);
}

/* Role tidak bisa diedit */
#page-settings .form-group input[readonly] {
  opacity: 0.75;
  cursor: default;
}

/* Action */
#page-settings .settings-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 22px;
}

/* Tombol Simpan */
#page-settings #save-profile-settings {
  height: 38px;
  padding: 0 17px;

  background: var(--green);
  color: #06130c;

  border: 0;
  border-radius: 7px;

  font-size: 13px;
  font-weight: 650;
  cursor: pointer;

  transition:
    background 0.2s ease,
    transform 0.15s ease;
}

#page-settings #save-profile-settings:hover {
  background: #22e17b;
}

#page-settings #save-profile-settings:active {
  transform: translateY(1px);
}

/* Responsive */
@media (max-width: 700px) {
  #page-settings .settings-card {
    max-width: none;
  }

  #page-settings .settings-form {
    padding: 18px;
  }

  #page-settings .settings-card-header {
    padding: 18px;
  }

  #page-settings .settings-actions {
    justify-content: stretch;
  }

  #page-settings #save-profile-settings {
    width: 100%;
  }
}

/* =========================================================
   SETTINGS — WHATSAPP
   ========================================================= */

#page-settings .settings-card {
  margin-top: 18px;
}

#page-settings .settings-form {
  margin-top: 18px;
}

#setting-default-whatsapp {
  width: 100%;
}

/* =====================================================
   MOBILE SIDEBAR MENU
   ===================================================== */

@media (max-width: 768px) {

  .sidebar.mobile-open {
  display: block;
  position: fixed;
  top: 0;
  left: 0;
  width: 250px;
  height: 100vh;
  overflow-y: auto;
  z-index: 1000;
}

  .mobile-menu {
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

}

/* =========================================================
   SEGMENT — MOBILE RESPONSIVE
   ========================================================= */

@media (max-width: 768px) {

  .segment-create-form {
    grid-template-columns: 1fr !important;
    gap: 12px !important;
  }

  .segment-create-form .form-group {
    width: 100%;
  }

  .segment-create-form input,
  .segment-create-form select {
    width: 100%;
    min-height: 42px;
  }

  .segment-create-form #createSegmentBtn {
    width: 100%;
    min-height: 42px;
  }

}

/* =========================================================
   DATABASE LEADS — MOBILE FILTER
   ========================================================= */

@media (max-width: 768px) {

  .database-lead-filters {
    grid-template-columns: 1fr !important;
    gap: 12px !important;
  }

  .database-lead-filters .form-group {
    width: 100%;
  }

  .database-lead-filters input,
  .database-lead-filters select {
    width: 100%;
    min-height: 42px;
  }

}

/* =========================================================
   DATABASE LEADS — MOBILE CARD
   Desktop tidak berubah
   ========================================================= */

@media (max-width: 768px) {

  /* Hilangkan perilaku tabel melebar */
  :global(#page-leads .table-wrap) {
    overflow-x: visible !important;
  }

  :global(#page-leads table) {
    min-width: 0 !important;
    width: 100% !important;
  }

  /* Header tabel tidak diperlukan di mobile */
  :global(#page-leads thead) {
    display: none;
  }

  :global(#page-leads tbody) {
    display: block;
    width: 100%;
  }

  /* Setiap lead menjadi card */
  :global(#page-leads #allLeadsTable tr) {
    display: block !important;
    width: 100% !important;

    margin-bottom: 12px;
    padding: 14px !important;

    background: #121a15;
    border: 1px solid #24372c !important;
    border-radius: 12px;

    box-sizing: border-box;
  }

  /* Semua cell menjadi blok */
  :global(#page-leads #allLeadsTable td) {
    display: flex !important;
    align-items: center;

    width: 100% !important;
    min-width: 0 !important;
    height: auto !important;

    padding: 6px 0 !important;

    border: 0 !important;
    white-space: normal !important;

    box-sizing: border-box;
  }

  /* Label setiap data */
  :global(#page-leads #allLeadsTable td::before) {
    width: 78px;
    min-width: 78px;

    color: #718078;
    font-size: 9px;
    font-weight: 500;
    text-transform: uppercase;
  }

  :global(#page-leads #allLeadsTable td:nth-child(1)::before) {
    content: "Perusahaan";
  }

  :global(#page-leads #allLeadsTable td:nth-child(2)::before) {
    content: "PIC";
  }

  :global(#page-leads #allLeadsTable td:nth-child(3)::before) {
    content: "WhatsApp";
  }

  :global(#page-leads #allLeadsTable td:nth-child(4)::before) {
    content: "Kategori";
  }

  :global(#page-leads #allLeadsTable td:nth-child(5)::before) {
    content: "Status";
  }

  :global(#page-leads #allLeadsTable td:nth-child(6)::before) {
    content: "Aksi";
  }

  /* Perusahaan */
  :global(#page-leads #allLeadsTable .company) {
    min-width: 0 !important;
    width: auto !important;
    flex: 1;
  }

  :global(#page-leads #allLeadsTable .company-info) {
    min-width: 0 !important;
  }

  :global(#page-leads #allLeadsTable .company-info strong) {
    white-space: normal !important;
    overflow: visible !important;
    text-overflow: unset !important;

    font-size: 12px !important;
  }

  /* WhatsApp lebih mudah disentuh */
  :global(#page-leads #allLeadsTable .whatsapp-link) {
    min-height: 38px;

    padding: 8px 12px !important;

    font-size: 10px !important;
  }

  /* Tombol hapus */
  :global(#page-leads #allLeadsTable .delete-btn) {
    min-height: 38px;

    padding: 8px 14px !important;

    font-size: 10px !important;
  }

}

