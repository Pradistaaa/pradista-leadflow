function escapeHtml(value) {

  return String(value || "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");

}


function getProspectPhone(result) {

  return (
    result.phone ||
    result.phoneNumber ||
    result.whatsapp ||
    result.mobile ||
    ""
  );

}


function getProspectCompany(result) {

  return (
    result.title ||
    result.name ||
    result.company ||
    ""
  );

}


function getProspectCategory(result) {

  return (
    result.categoryName ||
    result.category ||
    "Other"
  );

}


function getProspectAddress(result) {

  return (
    result.address ||
    result.location ||
    ""
  );

}

function getProspectCity(result) {
  return String(
    result.city ||
    result.cityName ||
    result.address?.city ||
    prospectLocation?.value ||
    getProspectAddress(result) ||
    ""
  ).trim();
}


