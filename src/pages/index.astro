function getFollowupStageOptions(selectedStage = "") {
  return FOLLOWUP_STAGES.map(stage => `
    <option
      value="${stage.value}"
      ${stage.value === selectedStage ? "selected" : ""}
    >
      ${stage.label}
    </option>
  `).join("");
}

