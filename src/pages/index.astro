<script>

  import { supabase } from "./lib/supabase";

  document.addEventListener("change", async (event) => {
  const stageSelect = event.target.closest(
    "[data-followup-stage]"
  );

  if (!stageSelect) return;

  const leadId = Number(
    stageSelect.dataset.followupStage
  );

  const lead = leads.find(
    item => Number(item.id) === leadId
  );

  if (!lead || !lead.cloudId) return;

  const stageSebelumnya = lead.stage || "";
  lead.stage = stageSelect.value;

  localStorage.setItem(
    STORAGE_KEY,
    JSON.stringify(leads)
  );

  const { error } = await supabase
    .from("leadflow_leads")
    .update({
      stage: lead.stage,
      updated_at: new Date().toISOString()
    })
    .eq("id", lead.cloudId);

  if (error) {
    console.error("Gagal menyimpan tahapan:", error);

    lead.stage = stageSebelumnya;

    localStorage.setItem(
      STORAGE_KEY,
      JSON.stringify(leads)
    );

    renderFollowup();

    alert("Tahapan belum tersimpan ke data global.");
  }
});

  const logoutBtn =
  document.getElementById("logoutBtn");

if (logoutBtn) {
  logoutBtn.addEventListener("click", () => {
    localStorage.removeItem(
      "leadflow_logged_in"
    );

    window.location.href = "/login";
  });
}

    const STORAGE_KEY = "leadflow_leads";

    let leads = JSON.parse(
      localStorage.getItem(STORAGE_KEY) || "[]"
    );


    const modal =
      document.getElementById("leadModal");

    const form =
      document.getElementById("leadForm");

      function render() {

  const table = document.getElementById("leadsTable");

  table.innerHTML = "";

  leads.forEach((lead, index) => {

    const row = document.createElement("tr");

    let statusText = "New";
    let statusClass = "status-new";

    if (lead.status === "follow") {
      statusText = "Follow-up";
      statusClass = "status-follow";
    }

    if (lead.status === "contacted") {
      statusText = "Sudah Dihubungi";
      statusClass = "status-contacted";
    }

    if (lead.status === "meeting") {
      statusText = "Meeting";
      statusClass = "status-meeting";
    }

    if (lead.status === "deal") {
      statusText = "Deal";
      statusClass = "status-deal";
    }

    const whatsappNumber =
      String(lead.whatsapp || "")
      .replace(/\D/g, "");

    row.innerHTML = `
      <td>
        <div class="company">

          <div class="company-logo">
            ${(lead.company || "?").charAt(0).toUpperCase()}
          </div>

          <div class="company-info">
            <strong>${lead.company || "-"}</strong>
          </div>

        </div>
      </td>

      <td>
        <span class="pic-name">
          ${lead.pic || "-"}
        </span>
      </td>

      <td>
        ${
          lead.whatsapp
            ? `
              <a
                class="whatsapp-link"
                href="https://wa.me/${whatsappNumber}"
                target="_blank"
                rel="noopener noreferrer"
                data-whatsapp-index="${index}"
              >
                📱 ${lead.whatsapp}
              </a>
            `
            : `
              <span style="color:#68756d;font-size:10px;">
                Belum ada
              </span>
            `
        }
      </td>

      <td>
        <span class="category-text">
          ${lead.category || "-"}
        </span>
      </td>

      <td>
        <span class="status ${statusClass}">
          ${statusText}
        </span>
      </td>

      <td>
        <button
          type="button"
          class="delete-btn"
          data-delete="${index}"
        >
          Hapus
        </button>
      </td>
    `;

    table.appendChild(row);

  });

  updateStats();
renderActivities();
renderAllLeads();

}

function renderAllLeads() {

  const table =
    document.getElementById("allLeadsTable");

  const empty =
    document.getElementById("allLeadsEmpty");

  if (!table || !empty) return;

  table.innerHTML = "";

  if (leads.length === 0) {
    empty.style.display = "block";
    return;
  }

  empty.style.display = "none";

  leads.forEach((lead, index) => {

    const row =
      document.createElement("tr");

    let statusText = "New";
    let statusClass = "status-new";

    if (lead.status === "follow") {
      statusText = "Follow-up";
      statusClass = "status-follow";
    }

    if (lead.status === "contacted") {
      statusText = "Sudah Dihubungi";
      statusClass = "status-contacted";
    }

    if (lead.status === "meeting") {
      statusText = "Meeting";
      statusClass = "status-meeting";
    }

    if (lead.status === "deal") {
      statusText = "Deal";
      statusClass = "status-deal";
    }

    const whatsappNumber =
      String(lead.whatsapp || "")
        .replace(/\D/g, "");

    row.innerHTML = `

      <td>

        <div class="company">

          <div class="company-logo">
            ${(lead.company || "?")
              .charAt(0)
              .toUpperCase()}
          </div>

          <div class="company-info">

            <strong>
              ${lead.company || "-"}
            </strong>

          </div>

        </div>

      </td>

      <td>

        <span class="pic-name">
          ${lead.pic || "-"}
        </span>

      </td>

      <td>

        ${
          lead.whatsapp
            ? `
              <a
              class="whatsapp-link"
              href="https://wa.me/${whatsappNumber}"
              target="_blank"
              rel="noopener noreferrer"
              data-whatsapp-index="${index}"
            >
              📱 ${lead.whatsapp}
            </a>
            `
            : `
              <span style="color:#68756d;font-size:10px;">
