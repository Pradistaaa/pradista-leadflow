  ].sort((a, b) =>
    a.localeCompare(b, "id")
  );

  const categories = [
    ...new Set(
      leads
        .map(lead => lead.category)
        .filter(Boolean)
    )
  ].sort((a, b) =>
    a.localeCompare(b, "id")
  );

  const statuses = [
    ...new Set(
      leads
        .map(lead => lead.status)
        .filter(Boolean)
    )
  ];

