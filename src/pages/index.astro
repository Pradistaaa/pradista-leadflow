}

/* LIGHT THEME — pilihan tema di Settings */
body.light-theme #themeSelect {
  background: #ffffff;
  border-color: var(--border);
  color: var(--text) !important;
}

body.light-theme #themeSelect option {
  background: #ffffff;
  color: var(--text);
}

:global(#page-followup .followup-stage-select) {
  width: 100%;
  min-width: 145px;
  padding: 7px 9px;
  border: 1px solid var(--border);
  border-radius: 7px;
  outline: none;
  cursor: pointer;
  background: var(--card2);
  color: var(--text);
  font-size: 10px;
}

:global(#page-followup .followup-stage-select:focus) {
  border-color: var(--green);
}

:global(.ai-chat-launcher) {
  position: fixed;
  right: 24px;
  bottom: 24px;
  z-index: 10001;
  width: 56px;
  height: 56px;
  border: 0;
  border-radius: 50%;
  cursor: pointer;
  color: #001b0c;
  background: var(--green);
  box-shadow: 0 12px 30px rgba(0, 0, 0, .32);
  font-size: 24px;
}

:global(.ai-chat-launcher:hover) {
  transform: translateY(-2px);
}

:global(.ai-chat-panel) {
  position: fixed;
  right: 24px;
  bottom: 92px;
  z-index: 10001;
  display: none;
  width: min(390px, calc(100vw - 32px));
  height: min(570px, calc(100vh - 125px));
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: 18px;
  background: var(--card);
  box-shadow: 0 20px 55px rgba(0, 0, 0, .42);
}

:global(.ai-chat-panel.show) {
  display: flex;
  flex-direction: column;
}

:global(.ai-chat-header) {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 16px;
  color: #fff;
  background: linear-gradient(135deg, var(--green-dark), var(--green));
}

:global(.ai-chat-header strong) {
  display: block;
  font-size: 14px;
}

:global(.ai-chat-header small) {
  display: block;
  margin-top: 3px;
  font-size: 10px;
  opacity: .86;
}

:global(.ai-chat-close) {
  width: 32px;
  height: 32px;
  border: 1px solid rgba(255, 255, 255, .35);
  border-radius: 8px;
  cursor: pointer;
  color: #fff;
  background: transparent;
  font-size: 20px;
}

:global(.ai-chat-messages) {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 10px;
  overflow-y: auto;
  padding: 16px;
}

:global(.ai-chat-message) {
  max-width: 88%;
  padding: 10px 12px;
  border-radius: 13px;
  font-size: 12px;
  line-height: 1.55;
  white-space: pre-wrap;
}

:global(.ai-chat-message.assistant) {
  align-self: flex-start;
  border: 1px solid var(--border);
  color: var(--text);
  background: var(--card2);
  border-bottom-left-radius: 4px;
}

:global(.ai-chat-message.user) {
  align-self: flex-end;
  color: #fff;
  background: var(--green-dark);
  border-bottom-right-radius: 4px;
}

:global(.ai-chat-quick-actions) {
  display: flex;
  gap: 7px;
  overflow-x: auto;
  padding: 0 16px 12px;
}

:global(.ai-chat-quick-actions button) {
  flex: 0 0 auto;
  padding: 7px 9px;
  border: 1px solid var(--border);
  border-radius: 99px;
  cursor: pointer;
  color: var(--muted);
  background: var(--card2);
  font-size: 10px;
}

:global(.ai-chat-quick-actions button:hover) {
  border-color: var(--green);
  color: var(--green);
}

:global(.ai-chat-form) {
  display: flex;
  gap: 8px;
  padding: 12px;
  border-top: 1px solid var(--border);
}

:global(.ai-chat-input) {
  min-width: 0;
  flex: 1;
  resize: none;
  padding: 10px;
  border: 1px solid var(--border);
  border-radius: 10px;
  outline: none;
  color: var(--text);
  background: var(--card2);
  font: inherit;
  font-size: 12px;
  line-height: 1.4;
}

:global(.ai-chat-input:focus) {
  border-color: var(--green);
}

:global(.ai-chat-send) {
  align-self: flex-end;
  padding: 10px 13px;
  border: 0;
  border-radius: 10px;
  cursor: pointer;
  color: #001b0c;
  background: var(--green);
  font-size: 12px;
  font-weight: 700;
}

:global(.ai-chat-send:disabled) {
  cursor: not-allowed;
  opacity: .5;
}

@media (max-width: 768px) {
  :global(.ai-chat-launcher) {
    right: 16px;
    bottom: 16px;
  }

  :global(.ai-chat-panel) {
    right: 16px;
    bottom: 82px;
  }
}

.logo-icon img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
