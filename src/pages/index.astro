importFileInput?.addEventListener(
  "change",
  async () => {
    const file = importFileInput.files?.[0];

    importRows = [];

    importLeadsBtn.disabled = true;
    importLeadsBtn.style.opacity = ".5";
    importLeadsBtn.style.cursor = "not-allowed";
    importLeadsBtn.textContent = "Import 0 Lead";

    if (!file) return;

    if (
      !file.name.toLowerCase().endsWith(".csv")
    ) {
      showImportStatus(
        "Gunakan file berformat CSV.",
        "error"
      );

      return;
    }

    try {
      const text = await file.text();

      const firstLine =
        text.split(/\r?\n/)[0] || "";

      const delimiter =
        firstLine.split(";").length >
        firstLine.split(",").length
          ? ";"
          : ",";

      const csvRows =
        parseCsvText(text, delimiter);

      if (csvRows.length < 2) {
        showImportStatus(
          "CSV harus memiliki header dan minimal satu baris data.",
          "error"
        );

        renderImportPreview([]);
        return;
      }

      const headers = csvRows[0].map(
        normalizeColumnName
      );

      const rawRows = csvRows.slice(1);

      importRows = rawRows
        .map(values => {
          const row = {};

          headers.forEach(
            (header, index) => {
              row[header] =
                values[index] || "";
            }
          );

          return {
            company: getImportValue(row, [
              "perusahaan",
              "nama perusahaan",
              "company",
              "name"
            ]),
            pic: getImportValue(row, [
              "pic",
              "nama pic",
              "contact person",
              "contact",
              "kontak"
            ]),
            whatsapp: getImportValue(row, [
              "whatsapp",
              "wa",
              "nomor whatsapp",
              "no wa",
              "phone",
              "phone number"
            ]),
            category: getImportValue(row, [
              "kategori",
              "category"
            ]),
            city: getImportValue(row, [
              "kota",
              "city",
              "lokasi",
              "location"
            ]),
            status: getImportValue(row, [
              "status"
            ])
          };
        })
        .filter(row => row.company);

      renderImportPreview(importRows);

      if (importRows.length === 0) {
        showImportStatus(
          "Tidak ada data dengan kolom perusahaan yang valid.",
          "error"
        );

        return;
      }

      showImportStatus(
        `${importRows.length} lead siap dipreview. Data belum diimpor.`,
        "success"
      );

      importLeadsBtn.textContent =
  `Import ${importRows.length} Lead`;

importLeadsBtn.disabled = false;
importLeadsBtn.style.opacity = "1";
importLeadsBtn.style.cursor = "pointer";

    } catch (error) {
      console.error(error);

      showImportStatus(
        "File tidak dapat dibaca. Coba gunakan CSV lain.",
        "error"
      );
    }
  }
);

function normalizeImportedStatus(status) {
  const value =
    normalizeColumnName(status);

  const statusMap = {
  new: "new",
  baru: "new",
  contacted: "contacted",
  contact: "contacted",
  "sudah dihubungi": "contacted",
  follow: "follow",
  "follow up": "follow",
  followup: "follow",
  meeting: "meeting",
  deal: "deal"
};

  return statusMap[value] || "new";
}


function sanitizeImportedText(value) {
  return String(value || "")
    .replace(/[<>]/g, "")
    .trim();
}


importLeadsBtn?.addEventListener(
  "click",
  () => {
    if (importRows.length === 0) {
      showImportStatus(
        "Pilih file CSV terlebih dahulu.",
        "error"
      );

      return;
    }

    const existingCompanies =
      new Set(
        leads.map(lead =>
          String(lead.company || "")
            .trim()
            .toLowerCase()
        )
      );

    const importedCompanies = new Set();

    const validRows = importRows.filter(row => {
      const company =
        sanitizeImportedText(row.company);

      const companyKey =
        company.toLowerCase();

      if (
        !company ||
        existingCompanies.has(companyKey) ||
        importedCompanies.has(companyKey)
      ) {
        return false;
      }

      importedCompanies.add(companyKey);

      return true;
    });

    const skippedCount =
      importRows.length - validRows.length;

    if (validRows.length === 0) {
      showImportStatus(
        "Semua data sudah ada atau nama perusahaan kosong.",
        "error"
      );

      return;
    }

    const confirmed = confirm(
      `Import ${validRows.length} lead ke Database Leads?` +
      (
        skippedCount > 0
          ? `\\n\\n${skippedCount} data duplikat akan dilewati.`
          : ""
      )
    );

    if (!confirmed) return;

    const importedLeads =
      validRows.map((row, index) => ({
        id: Date.now() + index,
        company:
          sanitizeImportedText(row.company),
        pic:
          sanitizeImportedText(row.pic),
        whatsapp:
          sanitizeImportedText(row.whatsapp),
        category:
          sanitizeImportedText(
            row.category
          ) || "Other",
        city:
          sanitizeImportedText(row.city),
        status:
          normalizeImportedStatus(row.status),
        createdAt:
          new Date()
            .toISOString()
            .slice(0, 10)
      }));

    leads.unshift(...importedLeads);

    localStorage.setItem(
      STORAGE_KEY,
      JSON.stringify(leads)
    );

    render();
    populateLeadFilters();
    populateSegmentFilters();
    renderSegments();
    renderPipeline();
    renderFollowup();

    importRows = [];

    importFileInput.value = "";

    importLeadsBtn.disabled = true;
    importLeadsBtn.style.opacity = ".5";
    importLeadsBtn.style.cursor = "not-allowed";
    importLeadsBtn.textContent = "Import 0 Lead";

    renderImportPreview([]);

    showImportStatus(
      `${importedLeads.length} lead berhasil diimpor.` +
      (
        skippedCount > 0
          ? ` ${skippedCount} data duplikat dilewati.`
          : ""
      ),
      "success"
    );
  }
);

