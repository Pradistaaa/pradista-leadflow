async function addProspectToLeads(result, button) {
  const company = getProspectCompany(result);

  if (!company) {
    alert("Prospek ini tidak memiliki nama perusahaan.");
    return;
  }

  const exists = leads.some(
    (lead) =>
      lead.company.toLowerCase() ===
      company.toLowerCase()
  );

  if (exists) {
    alert(company + " sudah ada di Database Leads.");
    return;
  }

  button.disabled = true;
  button.textContent = "Menyimpan...";

  const lead = {
    id: Date.now(),
    cloudId: crypto.randomUUID(),
    company,
    pic: result.pic || result.contactPerson || "",
    whatsapp: getProspectPhone(result),
    city: getProspectCity(result),
    category: getProspectCategory(result),
    status: "new",
    stage: "",
    createdAt: new Date().toISOString().slice(0, 10)
  };

  const { data: savedLead, error } = await supabase
    .from("leadflow_leads")
    .insert(leadToDatabase(lead))
    .select()
    .single();

  if (error) {
    console.error("Gagal menyimpan prospek:", error);
    alert("Prospek belum tersimpan ke data global.");

    button.disabled = false;
    button.textContent = "Tambah ke Leads";
    return;
  }

  lead.id = getUiId(savedLead.id);

  leads.unshift(lead);

  localStorage.setItem(
    STORAGE_KEY,
    JSON.stringify(leads)
  );

  render();

  button.textContent = "✓ Sudah Ditambahkan";
  button.style.opacity = ".55";
  button.style.cursor = "default";

  showProspectStatus(
    company + " berhasil ditambahkan ke Database Leads.",
    "success"
  );
}


prospectSearchForm.addEventListener(
  "submit",
  async (event) => {

    event.preventDefault();


    const keyword =
      prospectKeyword.value.trim();

    const location =
      prospectLocation.value.trim();


    if (!keyword || !location) {

      showProspectStatus(
        "Kata kunci dan lokasi wajib diisi.",
        "error"
      );

      return;

    }


    prospectSearchBtn.disabled = true;

    prospectSearchBtn.textContent =
      "⏳ Mencari...";


    prospectResults.innerHTML = "";


    showProspectStatus(
      "Sedang mencari prospek..."
    );


    try {

      const response =
        await fetch(
          "/api/search-prospects",
          {
            method: "POST",

            headers: {
              "Content-Type":
                "application/json"
            },

            body:
              JSON.stringify({
                keyword,
                location,
                limit: 25
              })

          }
        );


      const data =
        await response.json();


      if (!response.ok || !data.success) {

        throw new Error(
          data.message ||
          "Gagal mencari prospek."
        );

      }


      const results =
        data.results || [];


      showProspectStatus(
        "Pencarian selesai. " +
        results.length +
        " prospek ditemukan."
      );


      renderProspectResults(results);


    } catch (error) {

      console.error(
        "Prospect search error:",
        error
      );


      showProspectStatus(
        error.message ||
        "Terjadi kesalahan saat mencari prospek.",
        "error"
      );


    } finally {

      prospectSearchBtn.disabled = false;

      prospectSearchBtn.textContent =
        "🔍 Cari";

    }

  }
