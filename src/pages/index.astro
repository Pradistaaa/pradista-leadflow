}



function renderActivities() {

  const activityList =
    document.getElementById("activityList");

  if (!activityList) return;

  if (leads.length === 0) {

    activityList.innerHTML = `
      <div class="activity">

        <div class="activity-icon">
          ✓
        </div>

        <div>
          <h4>LeadFlow siap digunakan</h4>

          <p>
            Tambahkan lead pertama Anda
            untuk mulai membangun database.
          </p>
        </div>

      </div>
    `;

    return;
  }

  function updateWhatsAppLinks() {

  const links =
    document.querySelectorAll(".whatsapp-link");

  links.forEach((link) => {

    const index =
      link.dataset.whatsappIndex;

    const lead =
      leads[index];

    if (!lead) return;

    const number =
      String(lead.whatsapp || "")
        .replace(/\D/g, "");

    if (!number) return;

    const message =
      campaigns[0]?.message
        ?.replace(
          /\[PERUSAHAAN\]/gi,
          lead.company || ""
        )
        || "";

    link.href =
      message
        ? `https://wa.me/${number}?text=${encodeURIComponent(message)}`
        : `https://wa.me/${number}`;

  });

}


  const latest = leads;


  activityList.innerHTML =
    latest.map((lead) => {

      let action = "Lead baru ditambahkan";

      if (lead.status === "follow") {
        action = "Lead masuk Follow-up";
      }

      if (lead.status === "meeting") {
        action = "Meeting dijadwalkan";
      }

      if (lead.status === "deal") {
        action = "Lead berhasil menjadi Deal";
      }

      return `

        <div class="activity">

          <div class="activity-icon">
            ✓
          </div>

          <div>

            <h4>${action}</h4>

            <p>
              ${lead.company || "-"}
              ${lead.pic ? " • " + lead.pic : ""}
            </p>

            <span class="activity-time">
              ${lead.createdAt || ""}
            </span>

          </div>

        </div>

      `;

    }).join("");

}

    function updateStats() {

      const today =
        new Date()
          .toISOString()
          .slice(0, 10);


      document.getElementById("totalLeads")
        .textContent = leads.length;


      document.getElementById("leadCount")
        .textContent = leads.length;


      document.getElementById("newLeadsToday")
        .textContent =
          leads.filter(
            lead => lead.createdAt === today
          ).length;


      const followups =
        leads.filter(
          lead => lead.status === "follow"
        ).length;


      document.getElementById("activeFollowups")
        .textContent = followups;


      document.getElementById("followupCount")
        .textContent = followups;


      const deals =
        leads.filter(
          lead => lead.status === "deal"
        ).length;


      const conversion =
        leads.length
          ? Math.round(
              (deals / leads.length) * 100
            )
          : 0;


      document.getElementById("conversionRate")
        .textContent = conversion + "%";

    }


    function openModal() {

      modal.classList.add("show");

    }


    function closeModal() {

      modal.classList.remove("show");

      form.reset();

    }


    document
      .getElementById("addLeadBtn")
      ?.addEventListener("click", openModal);


    document
      .getElementById("addLeadTop")
      .addEventListener("click", openModal);


    document
      .getElementById("addLeadPage")
      .addEventListener("click", openModal);

      document
  .getElementById("allLeadsAdd")
  .addEventListener("click", openModal);


    document
      .getElementById("closeModal")
      .addEventListener("click", closeModal);


    document
      .getElementById("cancelModal")
      .addEventListener("click", closeModal);


    modal.addEventListener("click", (event) => {

      if (event.target === modal) {
        closeModal();
      }

    });


    form.addEventListener("submit", async (event) => {

      event.preventDefault();

      const saveLeadButton =
  form.querySelector('button[type="submit"]');

if (saveLeadButton?.disabled) {
  return;
}

if (saveLeadButton) {
  saveLeadButton.disabled = true;
  saveLeadButton.textContent = "Menyimpan...";
}

      const company =
        document
          .getElementById("companyInput")
          .value
          .trim();


      const pic =
        document
          .getElementById("picInput")
