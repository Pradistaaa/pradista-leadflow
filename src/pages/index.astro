const aiChatLauncher =
  document.getElementById("aiChatLauncher");

const aiChatPanel =
  document.getElementById("aiChatPanel");

const aiChatClose =
  document.getElementById("aiChatClose");

const aiChatMessages =
  document.getElementById("aiChatMessages");

const aiChatForm =
  document.getElementById("aiChatForm");

const aiChatInput =
  document.getElementById("aiChatInput");

const aiChatSend =
  document.getElementById("aiChatSend");

const aiChatHistory = [];

function addAiChatMessage(role, content) {
  const message = document.createElement("div");

  message.className =
    `ai-chat-message ${role}`;

  message.textContent = content;

  aiChatMessages?.appendChild(message);

  aiChatMessages.scrollTop =
    aiChatMessages.scrollHeight;

  return message;
}

function openAiChat() {
  aiChatPanel?.classList.add("show");

  aiChatLauncher?.setAttribute(
    "aria-expanded",
    "true"
  );

  if (aiChatHistory.length === 0) {
    addAiChatMessage(
      "assistant",
      "Halo, saya Asisten LeadFlow. Saya bisa membantu membuat pesan campaign, draft follow-up, dan saran tahapan lead."
    );
  }

  aiChatInput?.focus();
}

function closeAiChat() {
  aiChatPanel?.classList.remove("show");

  aiChatLauncher?.setAttribute(
    "aria-expanded",
    "false"
  );
}

aiChatLauncher?.addEventListener(
  "click",
  () => {
    const isOpen =
      aiChatPanel?.classList.contains("show");

    if (isOpen) {
      closeAiChat();
    } else {
      openAiChat();
    }
  }
);

aiChatClose?.addEventListener(
  "click",
  closeAiChat
);

async function sendAiChatMessage(text) {
  const message = text.trim();

  if (!message || !aiChatMessages) return;

  addAiChatMessage("user", message);

  aiChatHistory.push({
    role: "user",
    content: message
  });

  if (aiChatInput) {
    aiChatInput.value = "";
  }

  if (aiChatSend) {
    aiChatSend.disabled = true;
    aiChatSend.textContent = "...";
  }

  const loadingMessage = addAiChatMessage(
    "assistant",
    "Sedang menyiapkan jawaban..."
  );

  try {
    const response = await fetch("/api/ai-chat", {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        messages: aiChatHistory
      })
    });

    const data = await response.json();

    if (!response.ok) {
      throw new Error(
        data.error ||
        "Asisten AI tidak dapat merespons."
      );
    }

    const reply =
      data.reply ||
      "Maaf, saya belum mendapatkan jawaban.";

    loadingMessage.textContent = reply;

    aiChatHistory.push({
      role: "assistant",
      content: reply
    });
  } catch (error) {
    loadingMessage.textContent =
      error.message ||
      "Terjadi kesalahan. Silakan coba lagi.";
  } finally {
    if (aiChatSend) {
      aiChatSend.disabled = false;
      aiChatSend.textContent = "Kirim";
    }

    aiChatInput?.focus();
  }
}

aiChatForm?.addEventListener(
  "submit",
  (event) => {
    event.preventDefault();

    sendAiChatMessage(
      aiChatInput?.value || ""
    );
  }
);

document.querySelectorAll("[data-ai-prompt]")
  .forEach(button => {
    button.addEventListener("click", () => {
      sendAiChatMessage(
        button.dataset.aiPrompt || ""
      );
    });
  });

function getUiId(databaseId) {
  return parseInt(
    String(databaseId)
      .replace(/-/g, "")
      .slice(0, 8),
    16
  );
}

function leadFromDatabase(row) {
  return {
    id: getUiId(row.id),
    cloudId: row.id,
    company: row.company || "",
    pic: row.pic || "",
    whatsapp: row.whatsapp || "",
    city: row.city || "",
    category: row.category || "",
    status: row.status || "new",
    stage: row.stage || "",
    createdAt: row.created_at
      ? row.created_at.slice(0, 10)
      : new Date().toISOString().slice(0, 10)
  };
}

function leadToDatabase(lead) {
  return {
    id: lead.cloudId || lead.id,
    company: lead.company || "",
    pic: lead.pic || null,
    whatsapp: lead.whatsapp || null,
    city: lead.city || null,
    category: lead.category || null,
    status: lead.status || "new",
    stage: lead.stage || "",
    created_at: lead.createdAt
      ? new Date(lead.createdAt).toISOString()
      : new Date().toISOString(),
    updated_at: new Date().toISOString()
  };
}

function campaignFromDatabase(row) {
  return {
    id: getUiId(row.id),
    cloudId: row.id,
    name: row.name || "",
    target: row.target || "all",
    category: row.category || "",
    status: row.status || "",
    message: row.message || "",
    isDefault: row.is_default || false,
    createdAt: row.created_at || new Date().toISOString(),
    updatedAt: row.updated_at || new Date().toISOString()
  };
}

function campaignToDatabase(campaign) {
  return {
    id: campaign.cloudId || campaign.id,
    name: campaign.name || "",
    target: campaign.target || "all",
    category: campaign.category || "",
    status: campaign.status || "",
    message: campaign.message || "",
    is_default: campaign.isDefault || false,
    created_at: campaign.createdAt || new Date().toISOString(),
    updated_at: new Date().toISOString()
  };
}

